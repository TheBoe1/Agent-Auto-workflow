# ============================================================
# Agent-Auto-workflow · 配置模板（复制为 .env 后填写真实值）
# 所有字段均可选；不填时工具自动降级到 Demo / 公开适配器。
# ============================================================

# ---------- content-research / engagement-analyzer（小红书登录态，可选）----------
# 留空：自动降级到 wikipedia / arxiv / baidu 等公开适配器
# 填写：可抓取小红书等需登录平台（从浏览器开发者工具复制 Cookie）
XIAOHONGSHU_COOKIE=

# ---------- bb-browser（可选，默认自动发现系统 Chrome）----------
CHROME_PATH=
BB_BROWSER_DAEMON_URL=127.0.0.1:19824

# ---------- humanize-writing / engagement-analyzer 深度归纳（LLM，可选）----------
# OpenAI-compatible 接口，provider 无关：
#   OpenAI        → https://api.openai.com/v1
#   Azure         → https://<res>.openai.azure.com/openai/deployments/<dep>/v1
#   阿里云百炼     → https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama    → http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- 缓存 ----------
CACHE_DIR=.cache
